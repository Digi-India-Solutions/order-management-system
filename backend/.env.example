PORT=5000
NODE_ENV=production

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=oms_db

# Security & JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_app_password
SMTP_FROM="OrderFlow OMS" <your_email@domain.com>

# Frontend Production URL for CORS and Email Links
FRONTEND_URL=https://oms.digiindiasolutions.com
